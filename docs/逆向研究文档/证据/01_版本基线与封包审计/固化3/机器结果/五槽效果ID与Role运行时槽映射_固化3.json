  "核心函数": {
    "地址": "0x0042B0D0",
    "循环边界": "0x0042B57E: cmp ebx,5；固定处理 slot 0..4",
    "直接调用者": [
      "0x0042B050",
      "0x0042CBE9"
    ],
    "DamageInfo写回": {
      "ID数组": "DamageInfo+0x10+slot*4，0x42B514",
      "计算值数组": "DamageInfo+0x24+slot*4，0x42B528；负数随后 clamp 0"
    },
    "FIRTTECH来源": {
      "数值字段": "record+0x64+slot*4（5 DWORD）",
      "ID字段": "record+0x78+slot*4（5 DWORD）",
      "指令": "0x42B126 / 0x42B12A"
    },
    "条件替代来源": {
      "关联Ail2记录": "当当前 record 槽值为0等条件成立时，可改读关联 Ail2 +0x50/+0x64 + slot*4；见 0x42B143..0x42B171。这里仅冻结“替代来源存在”，不冻结业务名。",
      "额外记录参数": "若 [esp+0x3C] 非空，则覆盖读 +0xE8+slot*4 与 +0xFC+slot*4；见 0x42B187..0x42B1A5。该记录在 Article/Ail2 路径中的确切身份与边界仍待独立闭合。"
    },
    "ID静态参数表": "ID 0..27 时，0x42B1A7..0x42B1BF 用 ID*0x10 索引 0x46A000 的 16-byte 记录并读取 +0x0C DWORD；ID 超出 0..27 时该局部值清零。",
    "ID到Role槽映射": "0x42B53A 从 0x46A668 + ID*8 读取首 DWORD；若 >=0，则访问 target RoleDefinition+0x1E8+mapped*4。",
    "Role槽抵消规则": {
      "指令范围": "0x42B549..0x42B569",
      "精确结构": "令 R=RoleDefinition[0x1E8+mapped*4]，V=DamageInfo[0x24+slot*4]。若 R>V，则 R:=R-V、V不变；否则 V:=V-R、Role槽不在该分支写零（后续是否有其他清理需单独跟踪）。",
      "边界": "只冻结可见整数运算与写回，不把 Role+0x1E8 槽命名为抗性/状态计时器/护盾等。"
    },
    "路径实参闭合": {
      "FIRTTECH路径": "0x42CBE9 调 0x42B0D0：arg3=FIRTTECH record，arg4=NULL，arg5=DamageInfo；因此读 +0x64/+0x78 两组五槽字段。",
      "Article_Ail2路径": "0x42A7D0 的第4参数在 0x42A89F 装入 EBX；此前 caller 已闭合该第4参数为 FightRole+0xCF4=Ail2 record*。0x42B050 调 0x42B0D0 时 arg3=NULL、arg4=EBX(Ail2)、arg5=DamageInfo，因此读 Ail2+0xE8/+0xFC 两组五槽字段。",
      "证据边界": "这里只证明当前两个直接调用路径的参数来源，不等于 0x42B0D0 不可能通过间接调用被其他类型复用。"
    },
    "大ID分支": {
      "条件": "0x42B313: cmp edi,0x1B；ID>27 进入独立分支",
      "行为": "0x42B318 写 DamageInfo+0x10+slot*4=ID；0x42B320 写 DamageInfo+0x24+slot*4=0x1F40(8000)；随后直接跳到下一 slot，跳过 0x46A668 与 Role+0x1E8 映射。",
      "结论": "Ail2 样本中 40/41/50/67 等 >27 ID 属于代码明确支持的独立结构分支，不构成 0x46A668 越界访问。业务含义仍未知。"
    }
  },
