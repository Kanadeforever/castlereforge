  "版本": "v0.7D阶段中-固化3",
  "Oracle_SHA256": "b10c65f56051e5a625b6c34857bcb73bd002efe3c158b6bd0cc2bb17fa871dcf",
  "结论等级": "A：Battle 与 EVE 两套独立 consumer 交叉证明字段坐标、max/current 成对关系、扣减、恢复、clamp、候选资源检查与主资源零值状态转移；作者原始资源名称仍未证明。",
  "坐标关系": {
    "FightRole中的内嵌RoleDefinition": "FightRole+0x84C，大小0x350",
    "RoleDefinition+0x2C": "FightRole+0x878",
    "RoleDefinition+0x30": "FightRole+0x87C",
    "RoleDefinition+0x34": "FightRole+0x880",
    "RoleDefinition+0x38": "FightRole+0x884"
  },
  "安全结构命名": {
    "RoleDefinition+0x2C / FightRole+0x878": "主生存资源上限值（max；作者资源名未知）",
    "RoleDefinition+0x30 / FightRole+0x87C": "主生存资源当前值（current；<=0 触发 Battle 失效类状态转移）",
    "RoleDefinition+0x34 / FightRole+0x880": "次资源上限值（max；作者资源名未知）",
    "RoleDefinition+0x38 / FightRole+0x884": "次资源当前值（current；作者资源名未知）"
  },
  "直接消费者与写入": [
    {
      "VA": "0x00421012/0x00421015",
      "事实": "DamageInfo+0x04 从目标主生存资源当前值扣除并写回 FightRole+0x87C"
    },
    {
      "VA": "0x00421022/0x00421024",
      "事实": "DamageInfo+0x08 从目标次资源当前值 FightRole+0x884 扣除"
    },
    {
      "VA": "0x0042104A..0x00421069",
      "事实": "主资源 current 被 clamp 到 [0, FightRole+0x878]"
    },
    {
      "VA": "0x00421076..0x004210B8",
      "事实": "次资源 current 被 clamp 到 [0, FightRole+0x880]"
    },
    {
      "VA": "0x00421043 -> 0x004231F0",
      "事实": "主资源 current<=0 且 FightRole+0x72C>0 时进入主资源零值状态转移"
    },
    {
      "VA": "0x004231F3..0x0042323C",
      "事实": "0x4231F0 再次检查主资源<=0，调用 0x4207B0(1)，设置 +0x72C=-1、+0x87C=0、关闭关联对象 flag 并调用 0x43F210"
    },
    {
      "VA": "0x00421165..0x004211BF",
      "事实": "FightRole+0x168/+0x16C 的正值分别加回主/次 current，并 clamp 到各自上限；随后聚合值清零"
    },
    {
      "VA": "0x00421249..0x00421273",
      "事实": "选中 FIRTTECH record 的 +0x38 扣次资源；除 FIRTTECH ID 0x12F 特例外，+0x34 扣主资源"
    },
    {
      "VA": "0x0042129B..0x004212B5",
      "事实": "Article/Ail2 record 的 +0x118/+0x11C 分别扣主/次资源"
    },
    {
      "VA": "0x004445D4..0x004445F7",
      "事实": "AI候选检查读取 FIRTTECH+0x38/+0x34，并分别要求次/主 current 足够；不足直接拒绝候选"
    },
    {
      "VA": "0x004206E2..0x0042070E",
      "事实": "周期路径会更新主 current；若结果<=0，同样调用 0x4231F0"
    },
    {
      "VA": "0x00420744..0x0042078A",
      "事实": "另一周期路径增加主 current，并 clamp 到主资源上限"
    }
  ],
  "动作资源消耗字段": {
    "FIRTTECH+0x34": "主生存资源动作消耗量：AI动作前检查 + 动作后实际扣除闭环；ID 0x12F 存在扣除特例。",
    "FIRTTECH+0x38": "次资源动作消耗量：AI动作前检查 + 动作后实际扣除闭环。",
    "Ail2+0x118/+0x11C": "Article 动作后分别扣主/次资源；当前静态证据已证明扣除语义，但尚未找到与 FIRTTECH 等价的 AI 前置可用性检查。"
  },
