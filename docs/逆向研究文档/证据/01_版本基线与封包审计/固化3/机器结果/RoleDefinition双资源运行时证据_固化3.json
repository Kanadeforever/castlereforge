  "禁止越界": [
    "不得仅凭上述结构把主/次资源作者名写成 HP/MP/SP/生命/法力；需要字符串/UI/脚本/更多直接 consumer 才能定作者术语。",
    "0x4231F0 可安全称主资源零值失效/移出战斗类转移，但“死亡”作为作者业务名仍需额外证据。",
    "FIRTTECH ID 0x12F 的主资源扣除特例原因未知。"
  ],
  "下一步验证": [
    "追 0x4231F0/0x421445 等零值与恢复路径的 UI/动画/状态 consumer，确定作者术语。",
    "追 FIRTTECH+0x34/+0x38 与 selector/class 的数据分布，判断资源消耗与动作类型的关系。",
    "追 Article/Ail2 +0x118/+0x11C 的前置可用性检查与显式请求失败路径。"
  ],
  "跨子系统EVE交叉证据": {
    "0x40E6C0": "EVE opcode 0x7C 路径，mode=1 调 0x43B8F0；既有 v0.7A 语义为对当前队伍成员两项 current/max 资源调整。",
    "0x43B8F0_mode2-like_additive": "直接对 +0x30/+0x38 做有符号增减，随后分别 clamp 到 +0x2C/+0x34；主 current 下限 1，次 current 下限 0。",
    "0x43B8F0_mode1-like_percentage": "直接用 +0x2C/+0x34 乘百分比生成 +0x30/+0x38，再各自 clamp；主 current 下限 1，次 current 下限 0。",
    "意义": "Battle 与 EVE 两套独立 consumer 同时证明 +2C/+30、+34/+38 是两对 max/current 资源。"
  }
