    ]
  },
  "基础派生标量": {
    "A0_0x42BA00": "role[+0x3C] + Σ(Ail2[role[+0x90/+0x94/+0x98]] [+0x3C])，仅 id>0 参与",
    "A_0x42BA80": "A0；若 role+0x1F4>0 → trunc(A0*7/10)；否则若 role+0x240>0 → trunc(A0*13/10)",
    "B0_0x42BAD0": "trunc(role[+0x40]/2) + Σ(Ail2[role[+0x90/+0x94/+0x98]] [+0x3C])，仅 id>0 参与",
    "B_0x42BB50": "B0；若 role+0x224>0 → trunc(B0/2) 并立即返回；否则若 +0x24C>0 → trunc(B0*13/10) 并立即返回；否则若 +0x200>0 → trunc(B0*7/10)"
  },
  "RNG": {
    "state_address": "0x0046E29C",
    "seed_function": "0x0045155B",
    "next_function": "0x00451565",
    "update": "state = (state * 0x343FD + 0x269EC3) mod 2^32",
    "return": "(signed_state >> 16) & 0x7FFF；结果范围 0..32767",
    "range_helper_0x42CCB0": "取两个 int 边界，若相等返回该值；否则排序后返回 min + RNG()%abs(max-min)",
    "battle_reseed": "0x442076 调 0x451583 取得系统时间转换值；0x44207C 调 0x45155B 写入 RNG state",
    "seed_direct_callers": [
      "0x004010C0",
      "0x0044207C"
    ],
    "seed_source_boundary": "0x451583 直接调用 GetLocalTime/GetSystemTime/GetTimeZoneInformation 并生成 32-bit 时间值；不依赖猜测具体 CRT 符号名。"
  },
  "整数公式": {
    "共同定义": {
      "A": "0x42BA80(performer)",
      "B": "0x42BB50(target)",
      "S": "performer RoleDefinition+0x3C",
      "K": "FIRTTECH+0x40",
      "R25_10": "0x42CCB0(trunc(S/10), trunc(S/25))，因 helper 自动排序，等价于从 [trunc(S/25), trunc(S/10)) 取模随机值（边界相等时直接返回边界）",
      "R50_10": "0x42CCB0(trunc(S/10), trunc(S/50))，同理",
      "Clamp0": "负值归 0",
      "Clamp1": "<=0 归 1",
      "除法": "按 x86 signed integer / magic-multiply 路径，按 0 截断；正常表值均非负"
    },
    "selector_default_0x42B5F0": "Clamp1(A + R25_10 - B)。0x42BCD0 虽接收第4参数 FIRTTECH*，当前实现未读取该参数。",
    "selector_2_0x42B630": "Clamp0(A + trunc((performer[主生存资源max/base +0x2C]-performer[主生存资源current +0x30])*K/10) + R50_10 - B)",
    "selector_3_0x42B6C0": "Clamp0(A + trunc(performer[主生存资源max/base +0x2C]*K/100) + R50_10 - B)",
    "selector_4_0x42B750": "Clamp0(trunc(A*K/10) + R50_10 - B)",
    "selector_5_0x42B7D0": "base=A+R50_10；Clamp0(base - trunc(B/base)*K)。base==0 的输入前提/保护尚需运行时边界验证。",
    "selector_6_0x42B840": "Clamp0(trunc(0x42B5F0(performer,target,FIRTTECH)*K/10))"
  },
